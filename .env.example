# Frontend (Render Static Site; safe for browser use with correct Supabase RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=

# Backend (Render Web Service only; NEVER expose to frontend)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
PORTAL_TOKEN_SECRET=
VRM_FRONTEND_URL=

# n8n integrations (configure when manual webhooks are activated)
N8N_BASE_URL=
ALERTS_WEBHOOK_TOKEN=
N8N_WEBHOOK_SECRET=
# Must match the backend PORTAL_TOKEN_SECRET for supplier assessment links
PORTAL_TOKEN_SECRET=
VRM_PORTAL_URL=
SMTP_FROM=
VRM_BACKEND_URL=
N8N_MANUAL_WEBHOOK_BASE_URL=

# Optional retention configuration
STALE_FINDING_DAYS=90
AUDIT_RETENTION_YEARS=5
SCORE_RETENTION_YEARS=2
