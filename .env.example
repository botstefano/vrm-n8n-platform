# Frontend (Render Static Site)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=

# Backend-only secrets (Render Web Service; never expose through VITE_*)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
N8N_MANUAL_WEBHOOK_BASE_URL=

# Shared integration values: set the same values in the backend and n8n
# Generate separate random secrets (at least 32 characters): portal HMAC and n8n callback authentication.
PORTAL_TOKEN_SECRET=
N8N_WEBHOOK_SECRET=
ALERTS_WEBHOOK_TOKEN=
N8N_BASE_URL=
VRM_FRONTEND_URL=

# n8n runtime/workflow environment
VRM_BACKEND_URL=
# Frontend URL ending in /portal, for example https://vrm.example.com/portal
VRM_PORTAL_URL=
SMTP_FROM=
SLACK_WEBHOOK_URL=
ALERT_FALLBACK_EMAIL=
NVD_MIN_CVSS=7
CT_LOOKBACK_DAYS=3
WORKFLOW_STALE_HOURS=12
STALE_FINDING_DAYS=90
AUDIT_RETENTION_YEARS=5
SCORE_RETENTION_YEARS=2

# n8n Code node requirements (self-hosted n8n only; understand the security implications)
NODE_FUNCTION_ALLOW_BUILTIN=crypto,tls,dns,net
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Optional n8n deployment settings
WEBHOOK_URL=
GENERIC_TIMEZONE=America/Lima
TZ=America/Lima
