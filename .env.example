# Frontend (Render Static Site; browser-safe only with server-side authorization and RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=

# Backend API (Render Web Service only; never expose in VITE_* or frontend)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
VRM_FRONTEND_URL=
# At least 32 random characters; use exactly the same value in n8n
PORTAL_TOKEN_SECRET=
N8N_WEBHOOK_SECRET=
ALERTS_WEBHOOK_TOKEN=
N8N_BASE_URL=
N8N_MANUAL_WEBHOOK_BASE_URL=

# n8n runtime/workflow environment (configure on the n8n host, not in the browser)
VRM_BACKEND_URL=
VRM_FRONTEND_URL=
VRM_PORTAL_URL=
SMTP_FROM=
SLACK_WEBHOOK_URL=
ALERT_FALLBACK_EMAIL=
NVD_MIN_CVSS=7
CT_LOOKBACK_DAYS=3
STALE_FINDING_DAYS=90
AUDIT_RETENTION_YEARS=5
SCORE_RETENTION_YEARS=2
NODE_FUNCTION_ALLOW_BUILTIN=crypto,tls,dns
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Optional n8n deployment settings (set according to your reverse proxy/hosting)
WEBHOOK_URL=
GENERIC_TIMEZONE=America/Lima
TZ=America/Lima
