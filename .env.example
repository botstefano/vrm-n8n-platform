# Frontend (Render Static Site)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=

# Backend-only secrets (Render Web Service; never expose through VITE_*)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
PORTAL_TOKEN_SECRET=
N8N_WEBHOOK_SECRET=
ALERTS_WEBHOOK_TOKEN=
N8N_BASE_URL=
N8N_MANUAL_WEBHOOK_BASE_URL=
VRM_FRONTEND_URL=
SLACK_WEBHOOK_URL=

# Optional backend retention settings
STALE_FINDING_DAYS=90
AUDIT_RETENTION_YEARS=5
SCORE_RETENTION_YEARS=2

# n8n Cloud variables and credentials are configured in the n8n UI.
# Never put N8N_WEBHOOK_SECRET, ALERTS_WEBHOOK_TOKEN, PORTAL_TOKEN_SECRET,
# Shodan API keys, or Slack webhook URLs in n8n custom Variables.
# Custom Variables are reserved for non-sensitive configuration values.

# Optional local timezone defaults
GENERIC_TIMEZONE=America/Lima
TZ=America/Lima
