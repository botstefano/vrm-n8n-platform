{
  "name": "WF-07 Scorecard Refresh",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "cron",
      "name": "Cron 1h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id FROM vendors WHERE status IN ('approved','conditional','monitoring','incident','reevaluation');",
        "options": {}
      },
      "id": "pg-vendors",
      "name": "Get Active Vendors",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        460,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "postgresVrm",
          "name": "Postgres VRM"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.VRM_BACKEND_URL }}/api/v1/scorecard/recalc/{{ $json.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Signature",
              "value": "={{ $env.N8N_WEBHOOK_SECRET }}"
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "batching": {
            "batch": {
              "batchSize": 5,
              "batchInterval": 250
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "recalc",
      "name": "Recalc Scorecard",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        300
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst ok = items.filter(i => i.json.statusCode >= 200 && i.json.statusCode < 300).length;\nconst fail = items.length - ok;\nreturn [{ json: { job_type: 'scorecard_refresh_all', interval_min: 60,\n  status: fail === 0 ? 'ok' : (ok === 0 ? 'error' : 'partial'),\n  total: items.length, ok, fail, meta: { total: items.length, ok, fail } } }];"
      },
      "id": "aggregate",
      "name": "Aggregate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO monitoring_jobs (vendor_id, job_type, last_run, next_run, status, result_meta)\nVALUES (NULL, $1, $5::timestamptz, now() + make_interval(mins => $2::int), $3, $4::jsonb)\nON CONFLICT (job_type) WHERE vendor_id IS NULL\nDO UPDATE SET last_run = EXCLUDED.last_run, next_run = EXCLUDED.next_run,\n              status = EXCLUDED.status, result_meta = EXCLUDED.result_meta;",
        "options": {
          "queryReplacement": "={{ [$json.job_type, $json.interval_min, $json.status, JSON.stringify($json.meta || {}), $json.last_run || new Date().toISOString()] }}"
        }
      },
      "id": "pg-log",
      "name": "Log Run",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1180,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "postgresVrm",
          "name": "Postgres VRM"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $('Aggregate').first().json.fail }}",
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "rightValue": 0
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-fail",
      "name": "IF Failures",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1420,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_BASE_URL }}/webhook/vrm-alerts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Alert-Token",
              "value": "={{ $env.ALERTS_WEBHOOK_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ type: 'scorecard_refresh', severity: 'medium', title: 'Scorecard: ' + $('Aggregate').first().json.fail + ' proveedores fallaron al recalcular', source: 'n8n', source_ref: 'scorecard_refresh', fingerprint: 'scorecard:partial' }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "alert",
      "name": "Send Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1660,
        300
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "vrm-manual/wf-07",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "manual-webhook",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        220,
        520
      ],
      "webhookId": "vrm-manual-wf-07",
      "credentials": {
        "httpHeaderAuth": {
          "id": "httpHeaderAlerts",
          "name": "VRM Alerts Webhook Auth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const manual = $('Manual Trigger');\nif (!manual.isExecuted) return [];\nconst trigger = manual.first().json || {};\nconst request = trigger.body || trigger;\nif (!request.request_id) return [];\nconst aggregate = $('Aggregate').first().json || {};\nconst total = Number(aggregate.total || 0);\nconst ok = Number(aggregate.ok || 0);\nconst fail = Number(aggregate.fail || 0);\nconst status = fail === 0 ? 'success' : ok === 0 ? 'failed' : 'partial';\nreturn [{ json: {\n  request_id: request.request_id,\n  workflow_code: 'wf-07',\n  status,\n  summary: 'Scorecards: ' + ok + '/' + total + ' recalculados; ' + fail + ' error(es).',\n  details: { total, ok, fail }\n} }];"
      },
      "id": "manual-completion-code-wf-07",
      "name": "Build Manual Completion",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2140,
        520
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.VRM_BACKEND_URL }}/api/v1/webhooks/n8n/workflow-completed",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Signature",
              "value": "={{ $env.N8N_WEBHOOK_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "manual-completion-http-wf-07",
      "name": "Report Manual Completion",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2380,
        520
      ],
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Cron 1h": {
      "main": [
        [
          {
            "node": "Get Active Vendors",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Active Vendors": {
      "main": [
        [
          {
            "node": "Recalc Scorecard",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Recalc Scorecard": {
      "main": [
        [
          {
            "node": "Aggregate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Aggregate": {
      "main": [
        [
          {
            "node": "Log Run",
            "type": "main",
            "index": 0
          },
          {
            "node": "IF Failures",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF Failures": {
      "main": [
        [
          {
            "node": "Send Alert",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Build Manual Completion",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Get Active Vendors",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Alert": {
      "main": [
        [
          {
            "node": "Build Manual Completion",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Manual Completion": {
      "main": [
        [
          {
            "node": "Report Manual Completion",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Lima"
  },
  "active": false,
  "pinData": {},
  "tags": [
    {
      "name": "scorecard"
    }
  ]
}
