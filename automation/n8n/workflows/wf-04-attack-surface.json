    {
      "parameters": {
        "jsCode": "const manual = $('Manual Trigger');\nif (!manual.isExecuted) return [];\nconst trigger = manual.first().json || {};\nconst request = trigger.body || trigger;\nif (!request.request_id) return [];\nconst summary = $('Analyze Surface').isExecuted\n  ? ($('Analyze Surface').all().map(item => item.json).find(item => item.kind === 'summary') || {})\n  : $('Build Empty Summary').first().json;\nconst meta = summary.meta || {};\nconst resultStatus = summary.status === 'error' ? 'failed' : summary.status === 'partial' ? 'partial' : 'success';\nconst findings = Number(meta.findings || 0);\nreturn [{ json: {\n  request_id: request.request_id,\n  workflow_code: 'wf-04',\n  status: resultStatus,\n  summary: 'Escaneo de superficie completado: ' + findings + ' hallazgo(s) procesado(s).',\n  details: meta\n} }];"
      },
