{
  "name": "WF-04 Attack Surface (Shodan)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24
            }
          ]
        }
      },
      "id": "cron",
      "name": "Cron 24h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, legal_name, website FROM vendors WHERE status IN ('approved','conditional','monitoring','incident') AND website IS NOT NULL ORDER BY criticality DESC LIMIT 200;",
        "options": {}
      },
      "id": "pg-vendors",
      "name": "Get Vendors",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        460,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "postgresVrm",
          "name": "Postgres VRM"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const it of $input.all()) {\n  try {\n    const u = new URL(/^https?:\\/\\//i.test(it.json.website) ? it.json.website : 'https://' + it.json.website);\n    out.push({ json: { vendor_id: it.json.id, host: u.hostname.toLowerCase() } });\n  } catch (e) { /* ignorar URL inválida */ }\n}\nif (!out.length) {\n  return [{ json: {\n    kind: 'summary',\n    job_type: 'shodan',\n    interval_min: 1440,\n    status: 'ok',\n    last_run: new Date().toISOString(),\n    meta: { scanned: 0, failed: 0, no_data: 0, blocked: 0, findings: 0, invalid_websites: items.length }\n  } }];\n}\nreturn out;"
      },
      "id": "extract",
      "name": "Extract Host",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.shodan.io/dns/resolve",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "hostnames",
              "value": "={{ $json.host }}"
            }
          ]
        },
        "options": {
          "timeout": 15000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 1100
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "resolve",
      "name": "Resolve IP",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        940,
        300
      ],
      "credentials": {
        "httpQueryAuth": {
          "id": "httpQueryShodan",
          "name": "Shodan API"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst out = [];\nfor (let i = 0; i < items.length; i++) {\n  const prev = $('Extract Host').itemMatching(i).json;\n  const r = items[i].json;\n  const ip = r && r.statusCode === 200 && r.body && typeof r.body === 'object' ? r.body[prev.host] : null;\n  out.push({ json: ip ? { ...prev, ip } : { ...prev, skip: true } });\n}\nreturn out;"
      },
      "id": "extract-ip",
      "name": "Extract IP",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1180,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.skip === true }}",
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-ip",
      "name": "IF Has IP",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1420,
        300
      ]
    },
    {
      "parameters": {},
      "id": "skip",
      "name": "Skip",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1660,
        500
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.shodan.io/shodan/host/{{ $json.ip }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "minify",
              "value": "true"
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 1100
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "shodan",
      "name": "Shodan Host",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1660,
        300
      ],
      "credentials": {
        "httpQueryAuth": {
          "id": "httpQueryShodan",
          "name": "Shodan API"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const PORTS = {\n  21: ['FTP', 'medium'], 23: ['Telnet', 'high'], 135: ['MS-RPC', 'high'], 139: ['NetBIOS', 'high'],\n  445: ['SMB', 'critical'], 1433: ['MS SQL', 'high'], 1521: ['Oracle DB', 'high'], 3306: ['MySQL', 'high'],\n  3389: ['RDP', 'critical'], 5432: ['PostgreSQL', 'high'], 5900: ['VNC', 'high'], 6379: ['Redis', 'critical'],\n  9200: ['Elasticsearch', 'high'], 11211: ['Memcached', 'high'], 27017: ['MongoDB', 'critical']\n};\nconst targets = $('Extract IP').all().map(i => i.json).filter(t => t.ip);\nconst out = [];\nlet failed = 0, scanned = 0, noData = 0, blocked = 0;\nfor (const it of $input.all()) {\n  const r = it.json;\n  if (r.skip === true) { blocked++; continue; }\n  if (r.statusCode === 404) { noData++; continue; }          // Shodan sin datos para esa IP\n  if (r.statusCode !== 200 || !r.body) { failed++; continue; }\n  scanned++;\n  const h = r.body;\n  const matchingTargets = targets.filter(x => x.ip === h.ip_str);\n  if (!matchingTargets.length) continue;\n  const vulns = Array.isArray(h.vulns) ? h.vulns : Object.keys(h.vulns || {});\n  for (const t of matchingTargets) {\n    for (const p of (h.ports || [])) {\n      const d = PORTS[p];\n      if (!d) continue;\n      out.push({ json: { kind: 'finding', vendor_id: t.vendor_id, source: 'shodan',\n        source_ref: 'port:' + h.ip_str + ':' + p,\n        title: 'Puerto ' + p + ' (' + d[0] + ') expuesto en ' + t.host,\n        description: 'Shodan detecta ' + d[0] + ' accesible desde Internet en ' + h.ip_str + ':' + p + '.',\n        severity: d[1],\n        evidence: { host: t.host, ip: h.ip_str, port: p, service: d[0], org: h.org, last_update: h.last_update } } });\n    }\n    if (vulns.length) {\n      out.push({ json: { kind: 'finding', vendor_id: t.vendor_id, source: 'shodan', source_ref: 'cves:' + h.ip_str,\n        title: vulns.length + ' CVE(s) potenciales en ' + t.host + ' (' + h.ip_str + ')',\n        description: 'Shodan asocia estas CVEs a los banners: ' + vulns.slice(0, 20).join(', '),\n        severity: 'high',\n        evidence: { host: t.host, ip: h.ip_str, cves: vulns.slice(0, 20), total: vulns.length } } });\n    }\n  }\n}\nconst findings = out.length;\nout.push({ json: { kind: 'summary', job_type: 'shodan', interval_min: 1440,\n  status: failed === 0 ? 'ok' : (scanned === 0 ? 'error' : 'partial'),\n  meta: { scanned, failed, no_data: noData, blocked, findings } } });\nreturn out;"
      },
      "id": "analyze",
      "name": "Analyze Surface",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1900,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.kind }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "finding"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-finding",
      "name": "IF Is Finding",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2140,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO vendor_findings\n  (vendor_id, source, source_ref, title, description, severity, status, evidence, detected_at, due_date)\nVALUES ($1::uuid, $2, $3, $4, $5, $6::finding_severity, 'open'::finding_status, $7::jsonb, now(),\n  now() + CASE $6::finding_severity\n    WHEN 'critical'::finding_severity THEN INTERVAL '7 days'\n    WHEN 'high'::finding_severity THEN INTERVAL '14 days'\n    WHEN 'medium'::finding_severity THEN INTERVAL '30 days'\n    ELSE INTERVAL '60 days' END)\nON CONFLICT (vendor_id, source, source_ref) DO UPDATE\nSET severity = EXCLUDED.severity,\n    title = EXCLUDED.title,\n    description = EXCLUDED.description,\n    evidence = EXCLUDED.evidence,\n    status = CASE WHEN vendor_findings.status IN ('closed','accepted') THEN 'open'::finding_status ELSE vendor_findings.status END,\n    closed_at = CASE WHEN vendor_findings.status IN ('closed','accepted') THEN NULL ELSE vendor_findings.closed_at END,\n    resolution = CASE WHEN vendor_findings.status IN ('closed','accepted') THEN NULL ELSE vendor_findings.resolution END,\n    due_date = CASE\n      WHEN vendor_findings.status = 'closed' THEN EXCLUDED.due_date\n      ELSE COALESCE(LEAST(vendor_findings.due_date, EXCLUDED.due_date), vendor_findings.due_date, EXCLUDED.due_date)\n    END,\n    updated_at = now()\nWHERE vendor_findings.status = 'closed'\n   OR CASE EXCLUDED.severity\n        WHEN 'critical'::finding_severity THEN 5\n        WHEN 'high'::finding_severity THEN 4\n        WHEN 'medium'::finding_severity THEN 3\n        WHEN 'low'::finding_severity THEN 2\n        ELSE 1\n      END\n      > CASE vendor_findings.severity\n        WHEN 'critical'::finding_severity THEN 5\n        WHEN 'high'::finding_severity THEN 4\n        WHEN 'medium'::finding_severity THEN 3\n        WHEN 'low'::finding_severity THEN 2\n        ELSE 1\n      END\nRETURNING id, vendor_id, source, source_ref, title, severity;",
        "options": {
          "queryReplacement": "={{ [$json.vendor_id, $json.source, $json.source_ref, $json.title, $json.description, $json.severity, JSON.stringify($json.evidence || {})] }}"
        }
      },
