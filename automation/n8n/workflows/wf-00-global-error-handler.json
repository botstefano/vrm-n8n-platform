{
  "name": "WF-00 Global Error Handler",
  "nodes": [
    {
      "parameters": {},
      "id": "err",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\nconst wf = (e.workflow && e.workflow.name) || 'desconocido';\nconst ex = e.execution || {};\nconst msg = (ex.error && ex.error.message) || 'sin mensaje';\nconst node = ex.lastNodeExecuted || (ex.error && ex.error.node && ex.error.node.name) || 'n/a';\nreturn [{ json: {\n  workflow: wf,\n  workflow_id: e.workflow && e.workflow.id,\n  execution_id: ex.id,\n  execution_url: ex.url,\n  node,\n  message: String(msg).slice(0, 500)\n}}];"
      },
      "id": "build",
      "name": "Build Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.VRM_BACKEND_URL }}/api/v1/webhooks/n8n/alert-request",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ type: 'workflow_failed', severity: 'high', title: 'Falló el workflow ' + $json.workflow, description: $json.node + ': ' + $json.message + ' · ' + $json.execution_url, source: 'n8n', source_ref: $json.workflow + ':' + $json.node, fingerprint: 'wf_error:' + $json.workflow + ':' + $json.node }) }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "alert",
      "name": "Send Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        300
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "vrmBackendCallbackAuth",
          "name": "VRM Backend Callback Auth"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.VRM_BACKEND_URL }}/api/v1/webhooks/n8n/workflow-failed",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow: $('Build Payload').first().json.workflow, workflow_id: $('Build Payload').first().json.workflow_id, execution_id: $('Build Payload').first().json.execution_id, execution_url: $('Build Payload').first().json.execution_url, node: $('Build Payload').first().json.node, message: $('Build Payload').first().json.message }) }}",
        "options": {
          "timeout": 10000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "report",
      "name": "Report Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        940,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "vrmBackendCallbackAuth",
          "name": "VRM Backend Callback Auth"
        }
      }
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Build Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Payload": {
      "main": [
        [
          {
            "node": "Send Alert",
            "type": "main",
            "index": 0
          },
          {
            "node": "Report Backend",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Lima"
  },
  "active": false,
  "pinData": {},
  "tags": [
    {
      "name": "core"
    },
    {
      "name": "errors"
    }
  ]
}
