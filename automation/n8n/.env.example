# ============================================================
#  VRM Platform — variables de entorno de n8n
#  Copiar a automation/n8n/.env y cambiar TODOS los "change-me".
#  Generar secretos:  openssl rand -hex 32
# ============================================================

# ---- Backend VRM ----
VRM_BACKEND_URL=http://mock-backend:8000
VRM_FRONTEND_URL=http://localhost:3000
VRM_PORTAL_URL=https://vrm.local/portal
N8N_WEBHOOK_SECRET=change-me-long-random          # header X-N8N-Signature hacia el backend
INTERNAL_API_TOKEN=change-me-internal-token       # header X-Internal-Token (WF-07)
PORTAL_TOKEN_SECRET=change-me-portal-hmac-secret  # firma HMAC de los links del portal (WF-05)

# ---- Alertas (WF-06) ----
ALERTS_WEBHOOK_TOKEN=change-me-alerts-token       # mismo valor que la credencial "VRM Alerts Webhook Auth"
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
SMTP_FROM=noreply@vrm.local
ALERT_FALLBACK_EMAIL=                             # opcional: destinatario si no hay usuarios con rol

# ---- Umbrales / retención ----
NVD_MIN_CVSS=7.0
CT_LOOKBACK_DAYS=3
STALE_FINDING_DAYS=90
AUDIT_RETENTION_YEARS=5
SCORE_RETENTION_YEARS=2

# ---- n8n ----
N8N_BASE_URL=http://n8n:5678
WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=change-me-32-chars-minimum-key
GENERIC_TIMEZONE=America/Lima
TZ=America/Lima
N8N_BLOCK_ENV_ACCESS_IN_NODE=false                # los workflows leen $env.*
NODE_FUNCTION_ALLOW_BUILTIN=crypto,tls            # WF-03 (tls) y WF-05 (crypto)

# ---- Infraestructura local (docker-compose) ----
POSTGRES_USER=vrm
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=vrm
